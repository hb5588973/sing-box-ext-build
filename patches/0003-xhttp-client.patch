+func TestUplinkDataHeaderChunks(t *testing.T) {
+	c := clientWith(t, modePacketUp, intRange{0, 0}, metaOptions{
+		UplinkDataPlacement: "header",
+		UplinkChunkSize:     "64-64", // small chunks to force multiple headers
