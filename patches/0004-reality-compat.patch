diff --git a/common/tls/reality_client_keyshare_test.go b/common/tls/reality_client_keyshare_test.go
new file mode 100644
index 000000000..c450f2ac7
--- /dev/null
+++ b/common/tls/reality_client_keyshare_test.go
@@ -0,0 +1,110 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"net"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+
+	utls "github.com/metacubex/utls"
+)
+
+// Guards for the REALITY key_share policy: the observed ClientHello must carry or
+// omit X25519MLKEM768 exactly as configured, and unknown values must be rejected
+// at config load.
+
+func testRealityClientOptions(t *testing.T, keyShare string) option.OutboundTLSOptions {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return option.OutboundTLSOptions{
+		Enabled:    true,
+		ServerName: "example.com",
+		UTLS: &option.OutboundUTLSOptions{
+			Enabled:     true,
+			Fingerprint: "chrome",
+		},
+		Reality: &option.OutboundRealityOptions{
+			Enabled:   true,
+			PublicKey: base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes()),
+			KeyShare:  keyShare,
+		},
+	}
+}
+
+func testRealityClient(t *testing.T, keyShare string) *RealityClientConfig {
+	t.Helper()
+	config, err := NewRealityClient(context.Background(), logger.NOP(), "example.com", testRealityClientOptions(t, keyShare))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return config.(*RealityClientConfig)
+}
+
+func realityHelloHasHybridShare(t *testing.T, client *RealityClientConfig) bool {
+	t.Helper()
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	defer serverConn.Close()
+	uConn, _, err := client.prepareClientHello(clientConn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, extension := range uConn.Extensions {
+		keyShares, isKeyShares := extension.(*utls.KeyShareExtension)
+		if !isKeyShares {
+			continue
+		}
+		for _, share := range keyShares.KeyShares {
+			if share.Group == utls.X25519MLKEM768 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func TestRealityKeyShareDefaultKeepsHybrid(t *testing.T) {
+	if !realityHelloHasHybridShare(t, testRealityClient(t, "")) {
+		t.Fatal("default key_share should keep the fingerprint's X25519MLKEM768")
+	}
+}
+
+func TestRealityKeyShareClassicalStripsHybrid(t *testing.T) {
+	if realityHelloHasHybridShare(t, testRealityClient(t, "classical")) {
+		t.Fatal("classical key_share should strip X25519MLKEM768")
+	}
+}
+
+func TestRealityKeyShareHybridKeepsHybrid(t *testing.T) {
+	if !realityHelloHasHybridShare(t, testRealityClient(t, "hybrid")) {
+		t.Fatal("hybrid key_share should carry X25519MLKEM768")
+	}
+}
+
+func TestRealityKeyShareUnknownRejected(t *testing.T) {
+	_, err := NewRealityClient(context.Background(), logger.NOP(), "example.com", testRealityClientOptions(t, "post-quantum"))
+	if err == nil {
+		t.Fatal("unknown key_share must be rejected")
+	}
+}
+
+func TestRealityKeyShareSurvivesClone(t *testing.T) {
+	client := testRealityClient(t, "classical")
+	cloned, ok := client.Clone().(*RealityClientConfig)
+	if !ok {
+		t.Fatal("Clone must return *RealityClientConfig")
+	}
+	if cloned.keyShare != "classical" {
+		t.Fatalf("keyShare after Clone = %q, want classical", cloned.keyShare)
+	}
+}
